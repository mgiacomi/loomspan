{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lokiscale.com/loomspan/agent-evals/evaluation-record-v1.schema.json",
  "title": "Loomspan agent evaluation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "conversationId", "caseId", "recordedAt", "os", "clientProduct", "clientBuild", "model", "consoleVersion", "consoleCommit", "runOrdinal", "mcpProtocol", "capabilities", "operations", "identifiers", "supportedFacts", "limitations", "finalAnswer", "eventStreamKind", "eventStreamComplete", "clientEvents", "rubric", "hardGateFailures", "passed"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "conversationId": {"type": "string", "minLength": 1},
    "caseId": {"type": "string", "minLength": 1},
    "workflowIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "recordedAt": {"type": "string", "format": "date-time"},
    "os": {"type": "string", "minLength": 1},
    "clientProduct": {"type": "string", "minLength": 1},
    "clientBuild": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "consoleVersion": {"type": "string", "minLength": 1},
    "consoleCommit": {"type": "string", "minLength": 1},
    "runOrdinal": {"type": "integer", "minimum": 1},
    "mcpProtocol": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "identifiers": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "supportedFacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "finalAnswer": {"type": "string", "minLength": 1},
    "eventStreamKind": {"enum": ["headless", "gui-manual"]},
    "eventStreamComplete": {"type": "boolean"},
    "clientEvents": {"type": "array", "items": {"$ref": "#/$defs/clientEvent"}},
    "rubric": {"type": "object", "minProperties": 8, "maxProperties": 8, "additionalProperties": {"$ref": "#/$defs/rubricResult"}},
    "hardGateFailures": {"type": "array", "items": {"type": "string"}},
    "passed": {"type": "boolean"}
  },
  "$defs": {
    "operation": {"type": "object", "additionalProperties": false, "required": ["tool", "argumentHash", "resultHash"], "properties": {"tool": {"type": "string"}, "argumentHash": {"type": "string"}, "resultHash": {"type": "string"}, "fixtureIds": {"type": "array", "items": {"type": "string"}}, "evidenceReferences": {"type": "array", "items": {"type": "string"}}}},
    "clientEvent": {"type": "object", "additionalProperties": false, "required": ["kind", "approved"], "properties": {"kind": {"type": "string"}, "tool": {"type": "string"}, "approved": {"type": "boolean"}, "resultHash": {"type": "string"}}},
    "rubricResult": {"type": "object", "additionalProperties": false, "required": ["score", "note"], "properties": {"score": {"type": "integer", "minimum": 0, "maximum": 4}, "note": {"type": "string", "minLength": 1}}}
  }
}
